# Copy this to .env and fill in your values.
# Never commit .env to git.

# Telegram bot token — get from @BotFather
BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Chat IDs to notify — comma-separated.
# Personal chat:  positive number  e.g. 123456789
# Group/channel:  negative number  e.g. -1001234567890
# Get your chat ID: message @userinfobot or @getidsbot
CHAT_IDS=-1001234567890,987654321

# Bot HTTP server (Alertmanager sends webhooks here)
LISTEN_HOST=127.0.0.1
LISTEN_PORT=5001
